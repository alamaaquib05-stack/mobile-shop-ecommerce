# ============================================
# MOBILE SHOP - ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to Git!

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE (MongoDB Atlas)
# ============================================
# Get from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/mobileshop

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a strong random string (min 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_random_string
JWT_EXPIRES_IN=7d

# ============================================
# CLOUDINARY (Image CDN)
# ============================================
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ============================================
# RAZORPAY (Payment Gateway)
# ============================================
# Get from: https://dashboard.razorpay.com/app/keys
# Use test keys for development (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# UPI PAYMENT (Manual Mode)
# ============================================
# Your shop's UPI ID for manual payments
SHOP_UPI_ID=yourshop@paytm
SHOP_UPI_NAME=MobileShop

# ============================================
# EMAIL (Gmail SMTP)
# ============================================
# Gmail App Password: https://myaccount.google.com/apppasswords
# Enable 2FA first, then generate app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourshop@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_EMAIL=admin@mobileshop.com

# ============================================
# FRONTEND URL
# ============================================
# Development
FRONTEND_URL=http://localhost:5173
# Production (update after deployment)
# FRONTEND_URL=https://your-app.vercel.app